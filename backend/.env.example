# AURA Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# The backend works fully offline with AI_PROVIDER=mock (default).

# -------------------------------------------------------------------
# AI Provider
# Options: mock | openai | anthropic | gemini
# "mock" uses the deterministic offline MockLLMProvider (no key needed).
# -------------------------------------------------------------------
AI_PROVIDER=mock

# OpenAI (required when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic Claude (required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Google Gemini (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# -------------------------------------------------------------------
# Database
# Default is a local SQLite file. For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/aura
# -------------------------------------------------------------------
DATABASE_URL=sqlite:///./aura.db

# -------------------------------------------------------------------
# Security
# Change SECRET_KEY and DEFAULT_EMERGENCY_PIN before any deployment.
# -------------------------------------------------------------------
SECRET_KEY=aura-dev-secret-key-change-in-production
DEFAULT_EMERGENCY_PIN=1234

# -------------------------------------------------------------------
# CORS origins (comma-separated list of allowed frontend origins)
# The defaults below cover local Vite and CRA dev servers.
# -------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
